---
import { site } from '../site';

const year = new Date().getFullYear();
const links = [
  { label: 'GitHub', href: site.github },
  { label: 'Email', href: site.email && `mailto:${site.email}` },
].filter((link) => link.href);
---

<footer
  class="flex flex-wrap items-center justify-between gap-4 border-t border-line-soft pt-8 pb-12 font-mono text-sm text-dim"
>
  <span>© {year} {site.name} · {site.author}</span>
  {
    links.length > 0 && (
      <div class="flex flex-wrap gap-1">
        {links.map((link) => (
          <a href={link.href} class="inline-flex min-h-11 items-center px-3 text-muted hover:text-fg">
            {link.label}
          </a>
        ))}
      </div>
    )
  }
</footer>
