---
import { site } from '../site';

const navLink = 'inline-flex min-h-11 items-center px-3.5 text-fg-soft transition-colors hover:text-fg';
const iconButton =
  'inline-flex size-11 items-center justify-center text-fg-soft transition-colors hover:text-fg';
---

<header
  data-site-header
  class="sticky top-0 z-20 border-b border-transparent bg-bg/85 backdrop-blur-md transition-colors duration-300 data-scrolled:border-line-soft"
>
  <div class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-4 px-6 py-5">
    <a href="/" aria-label={`${site.name} 首页`} class="font-mono text-2xl font-bold tracking-tight">
      <span>i</span><span class="floop">f</span><span>or</span><span class="caret text-accent">_</span>
    </a>
    <nav aria-label="主导航" class="flex flex-wrap items-center gap-1 font-mono text-[15px]">
      <a href="/#projects" class={navLink}>projects</a>
      <a href="/#about" class={navLink}>about</a>
      {
        site.github && (
          <a href={site.github} aria-label="GitHub" class={iconButton}>
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" />
            </svg>
          </a>
        )
      }
      <button
        type="button"
        id="theme-toggle"
        aria-label="切换深浅色"
        class:list={[iconButton, 'ml-1 cursor-pointer rounded-[10px] border border-line hover:border-line-strong']}
      >
        <svg class="light:hidden" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
        <svg class="hidden light:block" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<script>
  // 页面滚动后给顶栏加一条细分隔线
  const header = document.querySelector('[data-site-header]');
  const markScrolled = () => header?.toggleAttribute('data-scrolled', window.scrollY > 8);
  window.addEventListener('scroll', markScrolled, { passive: true });
  markScrolled();

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    if (next === 'light') root.dataset.theme = 'light';
    else delete root.dataset.theme;
    try {
      localStorage.setItem('theme', next);
    } catch {
      // 隐私模式下存不了，只影响下次打开时记不住选择
    }
  });
</script>
