---
import { MESSAGE_LIMITS } from '../lib/messages';

const input =
  'mt-2 w-full rounded-[10px] border border-line-strong bg-surface px-3.5 py-2.5 text-[15px] outline-none transition-colors placeholder:text-dim focus:border-accent';
const label = 'block text-sm font-medium text-fg-soft';
---

<dialog
  id="contact-dialog"
  aria-labelledby="contact-title"
  class="m-auto w-[min(480px,calc(100vw-32px))] rounded-2xl border border-line bg-surface p-0 text-fg shadow-[0_30px_80px_-30px_rgb(15_23_42/0.45)] backdrop:bg-slate-900/30 backdrop:backdrop-blur-sm"
>
  <div class="p-7">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 id="contact-title" class="text-xl font-bold">联系我</h2>
        <p class="mt-1.5 text-sm text-muted">留下想说的话，我会尽快回复。</p>
      </div>
      <button
        type="button"
        data-close-contact
        aria-label="关闭"
        class="-mt-2 -mr-2 inline-flex size-10 cursor-pointer items-center justify-center rounded-lg text-dim transition-colors hover:bg-chip hover:text-fg"
      >
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <form id="contact-form" class="mt-6 space-y-4" novalidate>
      <label class={label}>
        称呼 <span class="font-normal text-dim">（选填）</span>
        <input name="name" maxlength={MESSAGE_LIMITS.name} autocomplete="name" class={input} />
      </label>
      <label class={label}>
        联系方式 <span class="font-normal text-dim">（选填，邮箱或微信，方便我回复你）</span>
        <input name="contact" maxlength={MESSAGE_LIMITS.contact} class={input} />
      </label>
      <label class={label}>
        想说的话
        <textarea
          name="content"
          required
          rows="5"
          maxlength={MESSAGE_LIMITS.content}
          class:list={[input, 'resize-y leading-relaxed']}></textarea>
      </label>
      <!-- 给机器人准备的陷阱字段，正常用户看不到 -->
      <div aria-hidden="true" class="absolute -left-[9999px]">
        <input name="website" tabindex="-1" autocomplete="off" />
      </div>

      <p id="contact-error" role="alert" class="text-sm text-red-700 empty:hidden"></p>

      <div class="flex justify-end gap-3 pt-2">
        <button
          type="button"
          data-close-contact
          class="inline-flex min-h-11 cursor-pointer items-center rounded-[10px] border border-line-strong px-5 font-medium transition-colors hover:border-dim"
        >
          取消
        </button>
        <button
          type="submit"
          class="inline-flex min-h-11 cursor-pointer items-center rounded-[10px] bg-accent px-6 font-bold text-on-accent transition hover:brightness-110 disabled:cursor-wait disabled:opacity-60"
        >
          发送
        </button>
      </div>
    </form>

    <div id="contact-done" hidden class="mt-6 py-6 text-center">
      <p class="text-lg font-bold">已收到，谢谢！</p>
      <p class="mt-2 text-sm text-muted">我看到后会尽快回复你。</p>
      <button
        type="button"
        data-close-contact
        class="mt-6 inline-flex min-h-11 cursor-pointer items-center rounded-[10px] bg-accent px-6 font-bold text-on-accent"
      >
        好的
      </button>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('contact-dialog') as HTMLDialogElement;
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const done = document.getElementById('contact-done')!;
  const error = document.getElementById('contact-error')!;
  const submit = form.querySelector<HTMLButtonElement>('[type="submit"]')!;

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (target.closest('[data-open-contact]')) {
      form.hidden = false;
      done.hidden = true;
      error.textContent = '';
      dialog.showModal();
      form.querySelector<HTMLTextAreaElement>('textarea')!.focus();
    } else if (target.closest('[data-close-contact]')) {
      dialog.close();
    }
  });

  // 点遮罩关闭
  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = Object.fromEntries(new FormData(form));
    if (!String(data.content ?? '').trim()) {
      error.textContent = '写点想说的话吧';
      return;
    }
    submit.disabled = true;
    error.textContent = '';
    try {
      const response = await fetch('/api/messages', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error ?? '发送失败');
      form.reset();
      form.hidden = true;
      done.hidden = false;
    } catch (err) {
      error.textContent = err instanceof Error ? err.message : '发送失败，请稍后再试';
    } finally {
      submit.disabled = false;
    }
  });
</script>
