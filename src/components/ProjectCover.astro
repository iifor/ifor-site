---
import type { Project } from '../lib/projects';
import { mediaUrl } from '../lib/media';
import SeatsArt from './SeatsArt.astro';
import NeuralLoop from './NeuralLoop.astro';

interface Props {
  project: Project;
  class?: string;
  /** 首屏可见的封面：立即加载并提高优先级 */
  priority?: boolean;
}

const { project, class: className, priority = false } = Astro.props;
const { coverId, coverAlt, coverPosition, art, title } = project;
---

{
  coverId ? (
    <img
      src={mediaUrl(coverId)}
      alt={coverAlt ?? title}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
      class:list={['w-full bg-black object-cover', className]}
      style={`object-position: ${coverPosition}`}
    />
  ) : (
    <div class:list={['flex w-full items-center justify-center bg-surface-2', className]}>
      {art === 'seats' ? (
        <SeatsArt class="h-[92%] max-h-[260px] w-auto" />
      ) : art === 'loop' ? (
        <NeuralLoop class="h-[94%] w-auto" />
      ) : (
        <span class="font-mono text-2xl font-bold text-dim">{title.slice(0, 1).toUpperCase()}</span>
      )}
    </div>
  )
}
