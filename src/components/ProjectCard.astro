---
import type { Project } from '../lib/projects';
import ProjectCover from './ProjectCover.astro';
import Tag from './Tag.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, summary, tags, stack, demo, source } = project;
const href = `/projects/${project.id}/`;
---

<article
  class="group flex min-w-0 flex-col overflow-hidden rounded-2xl border border-line bg-surface transition duration-300 hover:-translate-y-1 hover:border-line-strong hover:shadow-[0_20px_50px_-28px_rgb(15_23_42/0.28)]"
>
  <a href={href} tabindex="-1" aria-hidden="true" class="block overflow-hidden border-b border-line">
    <ProjectCover
      project={project}
      class="h-[260px] transition-transform duration-500 ease-out group-hover:scale-[1.03]"
      sizes="(min-width: 1200px) 384px, (min-width: 768px) 50vw, 100vw"
    />
  </a>
  <div class="flex flex-1 flex-col gap-3.5 px-6 pt-6 pb-5.5">
    <div class="flex flex-wrap items-center justify-between gap-2.5">
      <h3 class="text-[22px] font-bold">
        <a href={href} class="transition-colors hover:text-accent">{title}</a>
      </h3>
      <div class="flex gap-1.5">
        {tags.map((tag) => <Tag>{tag}</Tag>)}
      </div>
    </div>
    <p class="text-[15px] leading-[1.75] text-muted">{summary}</p>
    <p class="font-mono text-[13px] text-dim">{stack.join(' · ')}</p>
    <div class="mt-auto flex flex-wrap gap-2 pt-1.5">
      <a href={href} class="group/link inline-flex min-h-11 items-center gap-1.5 px-1 text-[15px] font-bold text-accent">
        查看详情
        <span aria-hidden="true" class="transition-transform group-hover/link:translate-x-0.5">→</span>
      </a>
      {
        demo && (
          <a href={demo} class="inline-flex min-h-11 items-center px-3 text-[15px] text-fg-soft hover:text-fg">
            在线试玩
          </a>
        )
      }
      {
        source && (
          <a href={source} class="inline-flex min-h-11 items-center px-3 text-[15px] text-fg-soft hover:text-fg">
            源码
          </a>
        )
      }
    </div>
  </div>
</article>
