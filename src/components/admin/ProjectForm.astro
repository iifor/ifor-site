---
import type { ProjectFormValues } from '../../lib/project-form';
import { mediaUrl } from '../../lib/media';
import { ARCHITECTURE_EXAMPLE, NODE_KINDS } from '../../lib/architecture';

interface Props {
  values: ProjectFormValues;
  errors: string[];
  mode: 'new' | 'edit';
}

const { values, errors, mode } = Astro.props;

const field = 'block text-sm font-medium text-fg-soft';
const hint = 'font-normal text-dim';
const input =
  'mt-2 w-full rounded-[10px] border border-line-strong bg-surface px-3.5 py-2.5 text-[15px] font-normal text-fg outline-none transition-colors placeholder:text-dim focus:border-accent';
const card = 'rounded-2xl border border-line bg-surface p-6';
const cardTitle = 'mb-5 font-bold';
---

<form method="post" enctype="multipart/form-data" class="pb-24">
  {
    errors.length > 0 && (
      <div role="alert" class="mb-6 rounded-xl border border-red-200 bg-red-50 px-5 py-4 text-sm text-red-800">
        <p class="font-bold">没保存，有几处要改：</p>
        <ul class="mt-2 list-disc pl-5">
          {errors.map((e) => <li>{e}</li>)}
        </ul>
      </div>
    )
  }

  <div class="grid grid-cols-[minmax(0,1fr)_300px] items-start gap-6">
    <div class="space-y-6">
      <section class={card}>
        <h2 class={cardTitle}>基本信息</h2>
        <div class="space-y-5">
          <label class={field}>
            网址标识 <span class={hint}>（小写字母、数字和横线，例如 my-game；创建后不能改）</span>
            <input
              name="id"
              value={values.id}
              required
              pattern="[a-z0-9][a-z0-9\-]{0,62}"
              readonly={mode === 'edit'}
              class:list={[input, 'font-mono', mode === 'edit' && 'bg-surface-2 text-muted']}
            />
          </label>
          <label class={field}>
            标题
            <input name="title" value={values.title} required class={input} />
          </label>
          <label class={field}>
            简介 <span class={hint}>（显示在首页卡片上，一两句话）</span>
            <textarea name="summary" required rows="3" class:list={[input, 'resize-y leading-relaxed']}>{values.summary}</textarea>
          </label>
          <div class="grid grid-cols-2 gap-5">
            <label class={field}>
              标签 <span class={hint}>（逗号分隔）</span>
              <input name="tags" value={values.tags} placeholder="AI, 桌游" class={input} />
            </label>
            <label class={field}>
              技术栈 <span class={hint}>（逗号分隔）</span>
              <input name="stack" value={values.stack} placeholder="TypeScript, React" class={input} />
            </label>
          </div>
        </div>
      </section>

      <section class={card}>
        <div class="mb-5 flex items-center justify-between gap-4">
          <h2 class="font-bold">正文 <span class="text-sm font-normal text-dim">（Markdown）</span></h2>
          <label class="inline-flex min-h-10 cursor-pointer items-center rounded-lg border border-line-strong px-3.5 text-sm transition-colors hover:border-dim">
            插入图片
            <input type="file" accept="image/*" data-insert-image class="sr-only" />
          </label>
        </div>
        <textarea
          name="body"
          rows="18"
          data-body
          class:list={[input, 'mt-0 resize-y font-mono text-sm leading-relaxed']}
          placeholder="## 这是什么&#10;&#10;写写做了什么、怎么做的、踩过的坑。">{values.body}</textarea>
        <p data-upload-status class="mt-2 text-sm text-dim empty:hidden"></p>
      </section>

      <section class={card}>
        <div class="mb-2 flex items-center justify-between gap-4">
          <h2 class="font-bold">图解 <span class="text-sm font-normal text-dim">（JSON，选填，可以放多张）</span></h2>
          <button
            type="button"
            data-arch-example={JSON.stringify(ARCHITECTURE_EXAMPLE, null, 2)}
            class="inline-flex min-h-10 cursor-pointer items-center rounded-lg border border-line-strong px-3.5 text-sm transition-colors hover:border-dim"
          >
            填入示例
          </button>
        </div>
        <p class="mb-4 text-sm leading-relaxed text-muted">
          显示在项目详情页，会一步步搭建出来、连线上有数据流动；一张图写一个对象，多张图写成数组。<code class="font-mono text-xs">title</code>
          是图的标题，<code class="font-mono text-xs">nodes</code>
          写有哪些部分（kind：{NODE_KINDS.join(' / ')}，x、y 是第几列第几行），<code class="font-mono text-xs">edges</code>
          写怎么连，<code class="font-mono text-xs">steps</code> 写搭建顺序。留空就不显示。
        </p>
        <textarea
          name="architecture"
          rows="14"
          data-arch-input
          spellcheck="false"
          class:list={[input, 'mt-0 resize-y font-mono text-[13px] leading-relaxed']}>{values.architecture}</textarea>
      </section>
    </div>

    <div class="space-y-6">
      <section class={card}>
        <h2 class={cardTitle}>发布</h2>
        <label class="flex cursor-pointer items-center gap-3">
          <input type="checkbox" name="published" checked={values.published} class="size-4 accent-[var(--accent)]" />
          <span>在网站上显示</span>
        </label>
        <label class:list={[field, 'mt-5']}>
          排序 <span class={hint}>（越小越靠前）</span>
          <input name="order" type="number" value={values.order} required class={input} />
        </label>
      </section>

      <section class={card}>
        <h2 class={cardTitle}>封面</h2>
        <input type="hidden" name="coverId" value={values.coverId} />
        {
          values.coverId ? (
            <div>
              <img src={mediaUrl(Number(values.coverId))} alt="" class="aspect-[4/3] w-full rounded-lg border border-line bg-black object-cover" />
              <label class="mt-3 flex cursor-pointer items-center gap-2 text-sm text-muted">
                <input type="checkbox" name="removeCover" class="accent-[var(--accent)]" /> 去掉这张封面
              </label>
            </div>
          ) : (
            <label class={field}>
              没有图片时显示
              <select name="art" class={input}>
                <option value="" selected={values.art === ''}>标题首字母</option>
                <option value="seats" selected={values.art === 'seats'}>座位插画</option>
              </select>
            </label>
          )
        }
        <label class:list={[field, 'mt-5']}>
          {values.coverId ? '换一张图片' : '上传图片'}
          <input type="file" name="coverFile" accept="image/*" class="mt-2 block w-full text-sm text-muted file:mr-3 file:cursor-pointer file:rounded-lg file:border file:border-line-strong file:bg-surface file:px-3 file:py-2 file:text-fg" />
        </label>
        <label class:list={[field, 'mt-5']}>
          图片说明 <span class={hint}>（给读屏软件）</span>
          <input name="coverAlt" value={values.coverAlt} class={input} />
        </label>
        <label class:list={[field, 'mt-5']}>
          裁切位置 <span class={hint}>（如 center 20%）</span>
          <input name="coverPosition" value={values.coverPosition} class:list={[input, 'font-mono']} />
        </label>
      </section>

      <section class={card}>
        <h2 class={cardTitle}>链接</h2>
        <label class={field}>
          在线试玩
          <input name="demo" type="url" value={values.demo} placeholder="https://" class={input} />
        </label>
        <label class:list={[field, 'mt-5']}>
          源码
          <input name="source" type="url" value={values.source} placeholder="https://" class={input} />
        </label>
      </section>
    </div>
  </div>

  <div class="fixed right-0 bottom-0 left-56 border-t border-line bg-surface/90 backdrop-blur">
    <div class="mx-auto flex max-w-[960px] items-center gap-3 px-10 py-4">
      <button
        type="submit"
        name="intent"
        value="save"
        class="inline-flex min-h-11 cursor-pointer items-center rounded-[10px] bg-accent px-7 font-bold text-on-accent transition hover:brightness-110"
      >
        {mode === 'new' ? '创建项目' : '保存'}
      </button>
      <a href="/admin/projects" class="inline-flex min-h-11 items-center px-3 text-muted hover:text-fg">返回列表</a>
      {
        mode === 'edit' && (
          <>
            <a href={`/projects/${values.id}/`} target="_blank" class="inline-flex min-h-11 items-center px-3 text-muted hover:text-fg">
              在网站上查看 ↗
            </a>
            <button
              type="submit"
              name="intent"
              value="delete"
              formnovalidate
              data-confirm={`确定删除「${values.title}」吗？删除后不能恢复。`}
              class="ml-auto inline-flex min-h-11 cursor-pointer items-center rounded-[10px] px-4 text-red-700 transition-colors hover:bg-red-50"
            >
              删除项目
            </button>
          </>
        )
      }
    </div>
  </div>
</form>

<script>
  // 正文"插入图片"：上传后把 Markdown 图片语法插到光标处
  const picker = document.querySelector<HTMLInputElement>('[data-insert-image]');
  const body = document.querySelector<HTMLTextAreaElement>('[data-body]');
  const status = document.querySelector<HTMLElement>('[data-upload-status]');

  // 图解"填入示例"：已有内容时先确认
  const exampleButton = document.querySelector<HTMLButtonElement>('[data-arch-example]');
  const archInput = document.querySelector<HTMLTextAreaElement>('[data-arch-input]');
  exampleButton?.addEventListener('click', () => {
    if (!archInput) return;
    if (archInput.value.trim() && !confirm('用示例覆盖现在的内容吗？')) return;
    archInput.value = exampleButton.dataset.archExample ?? '';
    archInput.focus();
  });

  picker?.addEventListener('change', async () => {
    const file = picker.files?.[0];
    if (!file || !body || !status) return;
    status.textContent = '上传中…';
    const data = new FormData();
    data.append('file', file);
    try {
      const response = await fetch('/api/admin/media', { method: 'POST', body: data });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error);
      const snippet = `\n![${file.name.replace(/\.[^.]+$/, '')}](${result.url})\n`;
      const at = body.selectionStart ?? body.value.length;
      body.setRangeText(snippet, at, at, 'end');
      body.focus();
      status.textContent = '';
    } catch (error) {
      status.textContent = error instanceof Error && error.message ? error.message : '上传失败';
    } finally {
      picker.value = '';
    }
  });
</script>
