---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { countUnread } from '../lib/messages';

interface Props {
  title: string;
  /** 登录页不显示侧栏 */
  bare?: boolean;
}

const { title, bare = false } = Astro.props;
const path = Astro.url.pathname;
const unread = bare ? 0 : await countUnread();

const nav = [
  { href: '/admin/projects', label: '项目', active: path.startsWith('/admin/projects') },
  { href: '/admin/messages', label: '留言', active: path.startsWith('/admin/messages'), badge: unread },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-jetbrains" />
    <title>{title} · ifor 后台</title>
  </head>
  <body class="min-h-screen bg-surface-2 font-sans text-fg antialiased">
    {
      bare ? (
        <slot />
      ) : (
        <div class="flex min-h-screen">
          <aside class="sticky top-0 flex h-screen w-56 flex-none flex-col border-r border-line bg-surface px-4 py-6">
            <a href="/admin/projects" class="px-3 font-mono text-xl font-bold">
              i<span class="floop">f</span>or<span class="ml-2 font-sans text-sm font-medium text-dim">后台</span>
            </a>
            <nav aria-label="后台导航" class="mt-8 flex flex-col gap-1">
              {nav.map((item) => (
                <a
                  href={item.href}
                  aria-current={item.active ? 'page' : undefined}
                  class="flex min-h-11 items-center justify-between rounded-lg px-3 text-fg-soft transition-colors hover:bg-chip hover:text-fg aria-[current=page]:bg-chip aria-[current=page]:font-bold aria-[current=page]:text-fg"
                >
                  {item.label}
                  {item.badge ? (
                    <span class="rounded-full bg-accent px-2 py-0.5 font-mono text-xs text-on-accent">{item.badge}</span>
                  ) : null}
                </a>
              ))}
            </nav>
            <div class="mt-auto flex flex-col gap-1 text-sm">
              <a href="/" target="_blank" class="flex min-h-11 items-center rounded-lg px-3 text-muted transition-colors hover:bg-chip hover:text-fg">
                查看网站 ↗
              </a>
              <form method="post" action="/admin/logout">
                <button type="submit" class="flex min-h-11 w-full cursor-pointer items-center rounded-lg px-3 text-muted transition-colors hover:bg-chip hover:text-fg">
                  退出登录
                </button>
              </form>
            </div>
          </aside>
          <main class="min-w-0 flex-1 px-10 py-8">
            <div class="mx-auto max-w-[960px]">
              <slot />
            </div>
          </main>
        </div>
      )
    }

    <script>
      // 带 data-confirm 的按钮先弹确认框
      document.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLElement>('[data-confirm]');
        if (button && !confirm(button.dataset.confirm)) event.preventDefault();
      });
    </script>
  </body>
</html>
