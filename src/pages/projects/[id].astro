---
import { marked } from 'marked';
import Layout from '../../layouts/Layout.astro';
import ProjectCover from '../../components/ProjectCover.astro';
import Tag from '../../components/Tag.astro';
import ArchitectureDiagram from '../../components/ArchitectureDiagram.astro';
import { listProjects } from '../../lib/projects';

const projects = await listProjects();
const index = projects.findIndex((p) => p.id === Astro.params.id);
if (index === -1) return new Response(null, { status: 404 });

const project = projects[index];
const prev = projects[index - 1];
const next = projects[index + 1];
const { title, summary, tags, stack, demo, source } = project;
const html = await marked.parse(project.body);
---

<Layout title={title} description={summary}>
  <article class="mx-auto max-w-[820px] pt-6 pb-14">
    <a href="/#projects" class="inline-flex min-h-11 items-center font-mono text-sm text-dim transition-colors hover:text-fg">
      ← 返回项目
    </a>

    <header class="mt-6">
      <div class="flex flex-wrap gap-1.5">
        {tags.map((tag) => <Tag>{tag}</Tag>)}
      </div>
      <h1 class="mt-4 text-[clamp(34px,5vw,52px)] leading-tight font-bold tracking-tight">{title}</h1>
      <p class="mt-4 text-lg leading-[1.8] text-muted">{summary}</p>
      <dl class="mt-6 flex flex-wrap gap-x-10 gap-y-2 font-mono text-sm">
        <div class="flex gap-3">
          <dt class="text-dim">技术栈</dt>
          <dd>{stack.join(' · ')}</dd>
        </div>
      </dl>
      {
        (demo || source) && (
          <div class="mt-6 flex flex-wrap gap-3">
            {demo && (
              <a href={demo} class="inline-flex min-h-12 items-center rounded-[10px] bg-accent px-6 font-bold text-on-accent hover:opacity-90">
                在线试玩 →
              </a>
            )}
            {source && (
              <a href={source} class="inline-flex min-h-12 items-center rounded-[10px] border border-line-strong px-6 font-medium hover:border-dim">
                源码
              </a>
            )}
          </div>
        )
      }
    </header>

    {
      // 只有真正上传了封面图才显示；没有图时的插画只是首页卡片的占位，详情页不放
      project.coverId && (
        <div class="mt-10 overflow-hidden rounded-2xl border border-line">
          <ProjectCover
            project={project}
            class="h-[clamp(240px,48vw,440px)]"
            sizes="(min-width: 868px) 820px, 100vw"
            priority
          />
        </div>
      )
    }
  </article>

  {
    project.architecture.map((spec, i) => (
      <section aria-label={spec.title ?? '图解'} class="pb-14">
        <p class="font-mono text-[13px] tracking-[0.18em] text-dim uppercase">
          {String(i + 1).padStart(2, '0')} · Diagram
        </p>
        <h2 class="mt-2 mb-6 text-2xl font-bold">{spec.title ?? '它是怎么搭起来的'}</h2>
        <ArchitectureDiagram spec={spec} />
      </section>
    ))
  }

  <article class="mx-auto max-w-[820px] pb-24">
    <div class="prose mt-4" set:html={html} />

    <nav aria-label="其他项目" class="mt-20 grid grid-cols-2 gap-4 border-t border-line-soft pt-8">
      {
        prev ? (
          <a
            href={`/projects/${prev.id}/`}
            class="group rounded-xl border border-line p-5 transition-colors hover:border-line-strong"
          >
            <span class="text-sm text-dim">← 上一个</span>
            <span class="mt-1 block font-bold transition-colors group-hover:text-accent">{prev.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a
            href={`/projects/${next.id}/`}
            class="group rounded-xl border border-line p-5 text-right transition-colors hover:border-line-strong"
          >
            <span class="text-sm text-dim">下一个 →</span>
            <span class="mt-1 block font-bold transition-colors group-hover:text-accent">{next.title}</span>
          </a>
        )
      }
    </nav>
  </article>
</Layout>
