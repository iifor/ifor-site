---
import Layout from '../layouts/Layout.astro';
import NeuralLoop from '../components/NeuralLoop.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { listProjects } from '../lib/projects';
import { site } from '../site';

const projects = await listProjects();

const tags = [...new Set(projects.flatMap((p) => p.tags))];
const pad = (n: number) => String(n).padStart(2, '0');

const about = [
  { label: '名字', value: site.author },
  { label: '关注', value: site.likes.join(' / ') },
  { label: '在做', value: site.now },
  ...(site.email ? [{ label: '邮箱', value: site.email, href: `mailto:${site.email}` }] : []),
  ...(site.github ? [{ label: 'GitHub', value: site.github.replace(/^https?:\/\//, ''), href: site.github }] : []),
];

const kicker = 'font-mono text-[13px] tracking-[0.18em] text-dim uppercase';
---

<Layout>
  <section class="relative flex items-center gap-10 pt-14 pb-28">
    <div class="relative z-10 min-w-0 flex-[1_1_0]">
      <p class:list={['rise flex items-center gap-2.5', kicker]}>
        <span class="relative flex size-2">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-accent opacity-60 motion-reduce:hidden"></span>
          <span class="relative inline-flex size-2 rounded-full bg-accent"></span>
        </span>
        ifor · if + for
      </p>
      <h1 class="rise mt-6 text-[clamp(44px,5.2vw,72px)] leading-[1.12] font-bold tracking-[-0.02em] [animation-delay:70ms]">
        把好奇心，<br /><span class="floop">循环</span>成作品。
      </h1>
      <p class="rise mt-7 max-w-[500px] text-lg leading-[1.8] text-muted [animation-delay:140ms]">
        你好，我是 {site.author}。先判断一个想法值不值得做，再一遍遍把它做出来。这里收着 AI 实验、桌游、3D 小玩意，以及所有让我好奇、忍不住动手的东西。
      </p>
      <div class="rise mt-10 flex flex-wrap gap-3 [animation-delay:210ms]">
        <a
          href="#projects"
          class="group inline-flex min-h-12 items-center gap-1.5 rounded-[10px] bg-accent px-6 font-bold text-on-accent transition hover:brightness-110"
        >
          看看项目 <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
        </a>
        <a
          href="#about"
          class="inline-flex min-h-12 items-center rounded-[10px] border border-line-strong px-6 font-medium transition-colors hover:border-dim"
        >
          关于我
        </a>
      </div>
      <dl class="rise mt-12 flex gap-10 font-mono text-[13px] [animation-delay:280ms]">
        <div>
          <dt class="text-dim">PROJECTS</dt>
          <dd class="mt-1 text-2xl font-bold text-fg">{pad(projects.length)}</dd>
        </div>
        <div>
          <dt class="text-dim">TAGS</dt>
          <dd class="mt-1 text-2xl font-bold text-fg">{pad(tags.length)}</dd>
        </div>
        <div>
          <dt class="text-dim">STATUS</dt>
          <dd class="mt-2.5 text-fg-soft">迭代中…</dd>
        </div>
      </dl>
    </div>

    <div class="rise relative min-w-0 flex-[1_1_0] [animation-delay:280ms]">
      <div aria-hidden="true" class="dot-grid absolute -inset-10"></div>
      <div
        aria-hidden="true"
        class="absolute inset-0 bg-[radial-gradient(circle_at_60%_50%,color-mix(in_oklab,var(--accent)_14%,transparent),transparent_62%)]"
      >
      </div>
      <NeuralLoop class="relative w-full" />
    </div>
  </section>

  <section id="projects" class="scroll-mt-24 pt-6 pb-26">
    <p class={kicker}>01 · Projects</p>
    <h2 class="mt-3 text-[34px] font-bold tracking-tight">项目</h2>
    <p class="mt-2 text-muted">做过的东西，挑你感兴趣的看。</p>

    <div class="mt-10 grid grid-cols-[repeat(auto-fill,minmax(340px,1fr))] gap-6">
      {projects.map((project) => <ProjectCard project={project} />)}
      <article
        class="flex min-h-[420px] flex-col items-center justify-center gap-4 rounded-2xl border-[1.5px] border-dashed border-line-strong p-8 text-center"
      >
        <svg
          aria-hidden="true"
          class="size-10 text-dim motion-safe:animate-[spin_6s_linear_infinite]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 12a9 9 0 1 1-2.64-6.36"></path>
          <path d="M21 3v6h-6"></path>
        </svg>
        <p class={kicker}>Next</p>
        <p class="text-muted">下一个项目还在循环里</p>
      </article>
    </div>
  </section>

  <section id="about" class="flex scroll-mt-24 items-start gap-14 border-t border-line-soft pt-18 pb-26">
    <div class="min-w-0 flex-[1_1_0]">
      <p class={kicker}>02 · About</p>
      <h2 class="mt-3 mb-5 text-[34px] font-bold tracking-tight">关于我</h2>
      <p class="max-w-[480px] text-[17px] leading-[1.8] text-muted">{site.intro}</p>
    </div>
    <dl class="min-w-0 flex-[1_1_0] rounded-[14px] border border-line bg-surface px-7 py-2">
      {
        about.map((item, i) => (
          <div class:list={['flex items-baseline gap-6 py-4', i > 0 && 'border-t border-line-soft']}>
            <dt class="w-16 flex-none font-mono text-[13px] text-dim">{item.label}</dt>
            <dd class="min-w-0">
              {item.href ? (
                <a href={item.href} class="text-fg transition-colors hover:text-accent">
                  {item.value}
                </a>
              ) : (
                item.value
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>
</Layout>
